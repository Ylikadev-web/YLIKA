# ── Obligatorias ──────────────────────────────────────────────────────
# Neon: https://console.neon.tech → Connection string (pooled / -pooler)
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo
AUTH_URL=http://localhost:3000

# ── Opcionales ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (archivos en la nube). Sin esto usa carpeta local uploads/
BLOB_READ_WRITE_TOKEN=

# Seed
SEED_ADMIN_EMAIL=miguel@ylika.local
SEED_ADMIN_PASSWORD=ylika-admin

# Bolsa embed
NEXT_PUBLIC_BOLSA_URL=
